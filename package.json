{
  "name": "vibratsiya-strun",
  "version": "1.0.0",
  "private": true,
  "description": "Static site + intake API for Вибрация струн",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node server/migrate.js",
    "test": "node ./node_modules/jest/bin/jest.js && jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/certs/"
    ]
  }
}
